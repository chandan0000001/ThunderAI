{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thunderai",
  "compatibility_date": "2026-11-01",
  "pages_build_output_dir": "dist",
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "html_handling": "single-page-application",
    "not_found_handling": "single-page-application"
  }
}
