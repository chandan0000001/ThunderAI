# Frontend Environment Configuration

# API Base URL (leave empty for local Vite dev proxy, or set to your Render backend in production)
# e.g. VITE_API_BASE_URL=https://thunder-ai-backend.onrender.com
VITE_API_BASE_URL=

# Google OAuth 2.0 Client ID (from Google Cloud Console -> Credentials -> OAuth 2.0 Client IDs)
# e.g. VITE_GOOGLE_CLIENT_ID=123456789-abcdef.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=
