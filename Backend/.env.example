# === SERVER & RUNTIME ===
PORT=3000
NODE_ENV=production
FRONTEND_URL=https://your-app.pages.dev
# Explicit CORS allowlist (comma-separated exact origins — NO wildcards)
CORS_ALLOWED_ORIGINS=https://your-app.pages.dev,https://your-app.vercel.app

# === DATABASE & REDIS ===
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/
REDIS_URL=redis://default:<password>@your-redis-host:15510
# 32-byte hex key for encrypting user BYOK API keys in Redis
BYOK_ENCRYPTION_KEY=your_64_character_hex_encryption_key_here

# === AUTH & SESSION SECURITY ===
JWT_SECRET=your_super_strong_jwt_secret_min_64_chars
JWT_EXPIRES_IN=7d
JWT_ALGORITHM=HS256
BCRYPT_SALT_ROUNDS=12
BCRYPT_ROUNDS=12

# === TOKEN LIMITS & SLIDING WINDOW ===
TOKEN_LIMIT=10000
TOKEN_WINDOW_SECONDS=18000

# === AI PROVIDERS (Supports comma-separated keys for automated round-robin) ===
OPENROUTER_API_KEY=your_openrouter_api_key_1,your_openrouter_api_key_2
GROQ_API_KEY=gsk_your_groq_api_key_1,gsk_your_groq_api_key_2
ANTHROPIC_API_KEY=sk-ant-api03-your_claude_key
OPENAI_API_KEY=sk-proj-your_openai_key
DEFAULT_AI_MODEL=openrouter/free
DEFAULT_FREE_MODEL=nvidia/nemotron-3.5-lightning:free
CLAUDE_MAX_TOKENS=4096
OPENROUTER_REFERER=https://your-app.pages.dev

# === EMAIL CONFIGURATION ===
# Primary / Production: Resend HTTP API (Port 443 HTTPS, reliable on cloud providers)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=noreply@your-domain.com
RESEND_FROM_NAME=Thunder AI

# Fallback: SMTP (Gmail / Custom SMTP with strict TLS)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_character_google_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# === GOOGLE OAUTH ===
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# === ADMIN BOOTSTRAP ===
ADMIN_EMAIL=admin@example.com
ADMIN_EMAILS=admin@example.com
ADMIN_NAME="System Administrator"
# Note: Wrap in quotes if password contains '#' or other special characters to prevent dotenv truncation
ADMIN_PASSWORD="your_strong_admin_password"

# === WEB SEARCH GROUNDING ===
TAVILY_API_KEY=tvly-your_tavily_api_key_here
