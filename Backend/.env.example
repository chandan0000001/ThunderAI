PORT=3000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/
JWT_SECRET=your_jwt_secret_here
# Multi-Provider API Keys (Supports comma-separated keys for automated Round-Robin load balancing)
OPENROUTER_API_KEY=your_openrouter_api_key_1,your_openrouter_api_key_2
GROQ_API_KEY=gsk_your_groq_api_key_1,gsk_your_groq_api_key_2
ANTHROPIC_API_KEY=sk-ant-api03-your_claude_key
OPENAI_API_KEY=sk-proj-your_openai_key
DEFAULT_AI_MODEL=openrouter/free
REDIS_URL=redis://default:<password>@your-redis-host:15510
TOKEN_LIMIT=10000
TOKEN_WINDOW_SECONDS=18000

# Gmail SMTP Email Verification
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_character_google_app_password

# Optional: Resend API (Recommended for Render free tier HTTPS delivery)
RESEND_API_KEY=re_your_resend_api_key

# Google OAuth Authentication
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
FRONTEND_URL=https://your-app.pages.dev,http://localhost:5173

# Admin Account Bootstrap (Comma-separated admin email list)
ADMIN_EMAILS=admin@example.com
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_strong_admin_password
